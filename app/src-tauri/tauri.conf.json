{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dresume",
  "version": "0.1.0",
  "identifier": "dev.diegorezm.dresume",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && cargo build --release -p dresume-cli",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "dresume",
        "width": 1400,
        "height": 900,
        "decorations": false,
        "dragDropEnabled": false,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "diegorezm",
    "homepage": "https://github.com/diegorezm/dresume",
    "category": "Productivity",
    "shortDescription": "Resume manager built on Typst",
    "longDescription": "Write resumes as YAML, style them with Typst templates, edit with live preview and your local AI agent. Includes the dresume CLI.",
    "copyright": "Copyright (C) 2026 diegorezm. AGPL-3.0-or-later",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "PortugueseBR"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
